# Copy to .env and fill in. Never commit .env.

# Wazuh indexer. Reached through an SSH tunnel, so the URL stays 127.0.0.1.
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=
WAZUH_CA_CERT=certs/root-ca.pem
WAZUH_VERIFY_TLS=true

# What to triage
MIN_RULE_LEVEL=5
HIGH_SEVERITY_LEVEL=12
POLL_SECONDS=30
LOOKBACK_MINUTES=60
BATCH_SIZE=25
RESULTS_INDEX=llm-triage

# LLM: anthropic | ollama | mock
LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Threat intel (optional, free tiers)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

STATE_FILE=.triage_state.json
OUTPUT_JSONL=output/triage_results.jsonl
